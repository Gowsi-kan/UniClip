<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UniClip.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1160" d:DesignHeight="760"
             x:Class="UniClip.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Background="#0C1110">
        <Grid Margin="28,20,28,16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="11">
                    <Border Width="38" Height="38" CornerRadius="13" Background="#B8F36B">
                        <TextBlock Text="u" Foreground="#14200D" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="UniClip" Foreground="#F1F5EF" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="PRIVATE DEVICE-TO-DEVICE SHARING" Foreground="#89958A" FontSize="9" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="16" Background="#171F1B" BorderBrush="#29332C"
                        BorderThickness="1" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7" Fill="#B8F36B" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="#C5CEC4" FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Spacing="4">
                    <TextBlock Text="Everything you need, in one place." Foreground="#F3F6F1"
                               FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="Pair once, then move text and files between devices on your local network."
                               Foreground="#A1ABA1" FontSize="13" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="12" Background="#202A23" Padding="10,7"
                        VerticalAlignment="Center">
                    <TextBlock Text="ENCRYPTED · LAN FIRST" Foreground="#CFD8CE" FontSize="9"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="0.92*,1.08*" ColumnSpacing="14">
                <Border Background="#141B17" BorderBrush="#2D3931" BorderThickness="1"
                        CornerRadius="20" Padding="18">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="PAIR YOUR DEVICES" Foreground="#B8F36B" FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock Text="Connect in a few steps." Foreground="#F0F4EF" FontSize="19"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Share the QR invite (or paste its data here), then compare the PIN after connecting."
                                       Foreground="#A1ABA1" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="#0F1511" BorderBrush="#27312A" BorderThickness="1"
                                CornerRadius="14" Padding="10" Height="164">
                            <Grid ColumnDefinitions="148,*" ColumnSpacing="12">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Spacing="8">
                                        <TextBlock Text="QR INVITE" Foreground="#89958A" FontSize="9"
                                                   FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Create an invite to show its QR code."
                                                   Foreground="#A1ABA1" FontSize="11" TextAlignment="Center"
                                                   TextWrapping="Wrap" MaxWidth="130" />
                                    </StackPanel>
                                    <Image Source="{Binding PairingQrCode}" Width="144" Height="144"
                                           IsVisible="{Binding HasPairingInvite}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                                    <TextBlock Text="VERIFICATION PIN" Foreground="#89958A" FontSize="9"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding VerificationPin}" Foreground="#B8F36B"
                                               FontSize="33" FontWeight="Bold" />
                                    <TextBlock Text="Compare this six-digit PIN on both devices after they connect."
                                               Foreground="#A1ABA1" FontSize="10" TextWrapping="Wrap"
                                               LineHeight="15" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Create / refresh invite"
                                    Command="{Binding CreatePairingInviteCommand}"
                                    IsEnabled="{Binding CanPair}" Classes="primary" />
                            <Button Content="Copy invite data" Click="CopyPairingInvite_OnClick"
                                    IsVisible="{Binding HasPairingInvite}" Classes="secondary" />
                        </StackPanel>
                        <TextBlock Text="{Binding PairingStatus}" Foreground="#A1ABA1" FontSize="10"
                                   TextWrapping="Wrap" MaxHeight="34" />

                        <TextBox Text="{Binding InvitationInput}"
                                 PlaceholderText="Paste the other device's invite here"
                                 AcceptsReturn="False" TextWrapping="NoWrap"
                                 HorizontalAlignment="Stretch" />
                        <Button Content="Connect securely"
                                Command="{Binding ConnectToInviteCommand}"
                                IsEnabled="{Binding CanPair}" HorizontalAlignment="Stretch"
                                Classes="secondary" />
                        <TextBlock Text="{Binding PairedDeviceCount, StringFormat='{}{0} PAIRED DEVICE'}"
                                   Foreground="#89958A" FontSize="9" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="14">
                    <Border Background="#141B17" BorderBrush="#28332C" BorderThickness="1"
                            CornerRadius="20" Padding="17">
                        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="CLIPBOARD" Foreground="#89958A" FontSize="9"
                                               FontWeight="Bold" />
                                    <TextBlock Text="Pick up where you left off." Foreground="#F0F4EF"
                                               FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="11"
                                        Background="#202A23">
                                    <TextBlock Text="▣" Foreground="#B8F36B" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <Border Grid.Row="1" Background="#0F1511" BorderBrush="#27312A"
                                    BorderThickness="1" CornerRadius="12" Padding="11">
                                <TextBlock Text="{Binding ClipboardPreview}" Foreground="#BBC5BA"
                                           FontSize="12" TextWrapping="Wrap" LineHeight="17"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Button Content="Preview clipboard" Click="PreviewClipboard_OnClick"
                                        Classes="secondary" />
                                <ToggleSwitch Grid.Column="1" Content="Sync clipboard"
                                              IsChecked="{Binding IsClipboardSyncEnabled}"
                                              IsEnabled="{Binding CanClipboardSync}"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="3" Text="{Binding ClipboardSyncStatus}"
                                       Foreground="#B8F36B" FontSize="10" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#141B17" BorderBrush="#28332C"
                            BorderThickness="1" CornerRadius="20" Padding="17">
                        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="FILE DROP" Foreground="#89958A" FontSize="9"
                                               FontWeight="Bold" />
                                    <TextBlock Text="Send files in a moment." Foreground="#F0F4EF"
                                               FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="11"
                                        Background="#202A23">
                                    <TextBlock Text="↥" Foreground="#B8F36B" FontSize="19"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <Border Grid.Row="1" Background="#0F1511" BorderBrush="#27312A"
                                    BorderThickness="1" CornerRadius="12" Padding="10"
                                    ClipToBounds="True">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding FilePickerStatus}" Foreground="#BBC5BA"
                                               FontSize="11" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" />
                                    <ItemsControl ItemsSource="{Binding SelectedFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Foreground="#89958A"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="Choose files" Click="ChooseFiles_OnClick"
                                        Classes="secondary" />
                                <Button Content="Send selected" Command="{Binding SendSelectedFilesCommand}"
                                        IsEnabled="{Binding CanSendFiles}" Classes="primary" />
                            </StackPanel>
                            <Grid Grid.Row="3">
                                <TextBlock Text="{Binding TransferStatus}" Foreground="#A1ABA1"
                                           FontSize="10" TextWrapping="Wrap" MaxHeight="34"
                                           TextTrimming="CharacterEllipsis" />
                                <Border IsVisible="{Binding HasIncomingTransferRequest}"
                                        Background="#202A23" BorderBrush="#354136" BorderThickness="1"
                                        CornerRadius="11" Padding="9">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Incoming file · approve to receive"
                                                       Foreground="#B8F36B" FontSize="10"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding IncomingTransferPrompt}"
                                                       Foreground="#D6DFD3" FontSize="9"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Spacing="5">
                                            <Button Content="Accept"
                                                    Command="{Binding AcceptIncomingTransferCommand}"
                                                    Classes="primary" Padding="8,6" />
                                            <Button Content="Decline"
                                                    Command="{Binding RejectIncomingTransferCommand}"
                                                    Classes="secondary" Padding="8,6" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <TextBlock Grid.Row="3" Text="Noise · X25519  /  Transfers are recipient-approved and SHA-256 verified"
                       Foreground="#58635A" FontSize="9" HorizontalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
