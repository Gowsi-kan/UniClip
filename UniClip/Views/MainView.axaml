<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:UniClip.ViewModels"
    mc:Ignorable="d" d:DesignWidth="1160" d:DesignHeight="760"
    x:Class="UniClip.Views.MainView"
    x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Background="{DynamicResource IosBgBrush}" RowDefinitions="Auto,*,Auto">

        <!-- ===== Large-title header ===== -->
        <Grid Grid.Row="0" Margin="24,12,24,0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="50" Height="50" CornerRadius="12" ClipToBounds="True">
                    <Image Source="/Assets/Icon.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="UniClip" Classes="large-title" />
                    <TextBlock
                        Text="Pair once, then move text and files between devices on your local network."
                        Classes="footnote" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                VerticalAlignment="Center">
                <Grid VerticalAlignment="Center">
                    <Border Classes="capsule-ok" IsVisible="{Binding IsWifiConnected}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Grid Width="18" Height="18" Margin="0,3,0,0" VerticalAlignment="Center">
                                <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Data="M12,21 L15.5,17.5 C13.6,15.6 10.4,15.6 8.5,17.5 Z M5,14 L7.1,16.1 C9.8,13.4 14.2,13.4 16.9,16.1 L19,14 C15.1,10.1 8.9,10.1 5,14 Z M1,10 L3.1,12.1 C8,7.2 16,7.2 20.9,12.1 L23,10 C16.9,3.9 7.1,3.9 1,10 Z"
                                    Fill="{DynamicResource IosGreenBrush}" />
                            </Grid>
                            <TextBlock Text="Wi-Fi connected" Foreground="{DynamicResource IosGreenTextBrush}"
                                FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Classes="capsule-alert" IsVisible="{Binding IsWifiDisconnected}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Grid Width="18" Height="18" Margin="0,3,0,0" VerticalAlignment="Center">
                                <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Data="M12,21 L15.5,17.5 C13.6,15.6 10.4,15.6 8.5,17.5 Z M5,14 L7.1,16.1 C9.8,13.4 14.2,13.4 16.9,16.1 L19,14 C15.1,10.1 8.9,10.1 5,14 Z M1,10 L3.1,12.1 C8,7.2 16,7.2 20.9,12.1 L23,10 C16.9,3.9 7.1,3.9 1,10 Z"
                                    Fill="{DynamicResource IosWifiDisconnectedBrush}" />
                            </Grid>
                            <TextBlock Text="Wi-Fi unavailable" Foreground="{DynamicResource IosWifiDisconnectedBrush}"
                                FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Classes="capsule-ok">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Width="12" Height="12" Stretch="Uniform"
                            Data="M8,11 V8 A4,4 0 0 1 16,8 V11 M5.5,11 H18.5 V20 H5.5 Z"
                            Stroke="{DynamicResource IosGreenTextBrush}" StrokeThickness="2.4"
                            StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                        <TextBlock Text="Encrypted · LAN first"
                            Foreground="{DynamicResource IosGreenTextBrush}" FontSize="12"
                            FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Grid>
                    <Border IsVisible="{Binding IsDisconnected}" Classes="capsule">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource IosOrangeBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionStatus}"
                                Foreground="{DynamicResource IosLabelBrush}" FontSize="12.5"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding IsConnected}" Classes="capsule-ok">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource IosGreenBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock Text="Securely connected"
                                Foreground="{DynamicResource IosGreenTextBrush}" FontSize="12.5"
                                FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ===== Content ===== -->
        <Grid Grid.Row="1" Margin="24,20,24,12" ColumnDefinitions="*,*" ColumnSpacing="20">

            <!-- ===== Left: pairing ===== -->
            <Grid>
                <Border IsVisible="{Binding IsDisconnected}" Classes="card">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="tile" Background="{DynamicResource IosIndigoBrush}">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                        Data="M8,11 V8 A4,4 0 0 1 16,8 V11 M5.5,11 H18.5 V20 H5.5 Z"
                                        Stroke="{DynamicResource IosAccentTextBrush}" StrokeThickness="2"
                                        StrokeLineCap="Round" StrokeJoin="Round"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Pair your devices" Classes="headline" />
                                    <TextBlock
                                        Text="Share this PIN with the other device, then enter its PIN here. Both devices must be on the same local network."
                                        Classes="footnote" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Border Classes="well" MinHeight="100">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock Text="Your pairing PIN" Classes="footnote"
                                        HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayedPairingPin}"
                                        Foreground="{DynamicResource IosGreenTextBrush}"
                                        FontFamily="{DynamicResource IosMonoFontFamily}"
                                        FontSize="34" FontWeight="SemiBold" LetterSpacing="2"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        Text="Enter this code on the other device. Expires in 10 minutes."
                                        Classes="footnote" FontSize="11.5" TextWrapping="Wrap"
                                        TextAlignment="Center" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Button Content="Generate a new PIN"
                                Command="{Binding CreatePairingCodeCommand}"
                                IsEnabled="{Binding CanPair}" Classes="secondary"
                                HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding PairingStatus}" Classes="footnote"
                                TextWrapping="Wrap" MaxHeight="34" />

                            <TextBlock Text="Enter the other device's PIN" Classes="footnote"
                                FontWeight="SemiBold" Margin="0,4,0,0" />
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8"
                                HorizontalAlignment="Center">
                                <TextBox x:Name="PinDigit1" Grid.Column="0" Tag="1" MaxLength="6"
                                    Text="{Binding PinDigit1}" Classes="pin-digit"
                                    TextChanged="PinDigit_OnTextChanged" KeyDown="PinDigit_OnKeyDown" />
                                <TextBox x:Name="PinDigit2" Grid.Column="1" Tag="2" MaxLength="6"
                                    Text="{Binding PinDigit2}" Classes="pin-digit"
                                    TextChanged="PinDigit_OnTextChanged" KeyDown="PinDigit_OnKeyDown" />
                                <TextBox x:Name="PinDigit3" Grid.Column="2" Tag="3" MaxLength="6"
                                    Text="{Binding PinDigit3}" Classes="pin-digit"
                                    TextChanged="PinDigit_OnTextChanged" KeyDown="PinDigit_OnKeyDown" />
                                <TextBox x:Name="PinDigit4" Grid.Column="3" Tag="4" MaxLength="6"
                                    Text="{Binding PinDigit4}" Classes="pin-digit"
                                    TextChanged="PinDigit_OnTextChanged" KeyDown="PinDigit_OnKeyDown" />
                                <TextBox x:Name="PinDigit5" Grid.Column="4" Tag="5" MaxLength="6"
                                    Text="{Binding PinDigit5}" Classes="pin-digit"
                                    TextChanged="PinDigit_OnTextChanged" KeyDown="PinDigit_OnKeyDown" />
                                <TextBox x:Name="PinDigit6" Grid.Column="5" Tag="6" MaxLength="6"
                                    Text="{Binding PinDigit6}" Classes="pin-digit"
                                    TextChanged="PinDigit_OnTextChanged" KeyDown="PinDigit_OnKeyDown" />
                            </Grid>
                            <Button Content="Pair using PIN"
                                Command="{Binding ConnectToPinCommand}"
                                IsEnabled="{Binding CanPair}" HorizontalAlignment="Stretch"
                                Classes="primary" />
                            <TextBlock
                                Text="{Binding PairedDeviceCount, StringFormat='{}{0} PAIRED DEVICE'}"
                                Classes="footnote" FontSize="11" FontWeight="SemiBold"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border IsVisible="{Binding IsConnected}" Classes="card" Padding="22">
                    <StackPanel VerticalAlignment="Center" Spacing="16">
                        <Border Width="64" Height="64" CornerRadius="32"
                            Background="{DynamicResource IosGreenBrush}"
                            HorizontalAlignment="Center">
                            <Path Width="28" Height="28" Stretch="Uniform"
                                Data="M4,12.5 L9.5,18 L20,6.5" Stroke="{DynamicResource IosAccentTextBrush}"
                                StrokeThickness="2.8" StrokeLineCap="Round"
                                StrokeJoin="Round" HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="4">
                            <TextBlock Text="You’re ready to share." FontSize="20"
                                FontWeight="Bold" Foreground="{DynamicResource IosLabelBrush}"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding PairedPeerLabel}" Classes="footnote"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Classes="well">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="tile" Background="{DynamicResource IosGreenBrush}">
                                    <Path Width="15" Height="15" Stretch="Uniform"
                                        Data="M8,11 V8 A4,4 0 0 1 16,8 V11 M5.5,11 H18.5 V20 H5.5 Z"
                                        Stroke="{DynamicResource IosAccentTextBrush}" StrokeThickness="2.2"
                                        StrokeLineCap="Round" StrokeJoin="Round"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="End-to-end encrypted connection"
                                    Classes="body" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Button Content="Disconnect device"
                            Command="{Binding DisconnectCommand}"
                            IsEnabled="{Binding CanDisconnect}"
                            Classes="danger" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Right: clipboard + file drop ===== -->
            <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="20">

                <!-- Clipboard -->
                <Border Classes="card">
                    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Classes="tile" Background="{DynamicResource IosBlueBrush}">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                    Data="M9,4 H15 V7 H9 Z M7,5.5 H5 V20 H19 V5.5 H17"
                                    Stroke="{DynamicResource IosAccentTextBrush}" StrokeThickness="2"
                                    StrokeLineCap="Round" StrokeJoin="Round"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Clipboard" Classes="headline" />
                                <TextBlock Text="Pick up where you left off." Classes="footnote" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Classes="well">
                            <TextBlock Text="{Binding ClipboardPreview}"
                                Foreground="{DynamicResource IosLabelBrush}"
                                FontSize="13" TextWrapping="Wrap" LineHeight="18"
                                TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Button Content="Preview clipboard" Click="PreviewClipboard_OnClick"
                                Classes="secondary" />
                            <Grid Grid.Column="1" Classes="row" ColumnDefinitions="*,Auto"
                                IsEnabled="{Binding CanClipboardSync}" VerticalAlignment="Center">
                                <TextBlock Text="Sync clipboard" Classes="body"
                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                    Margin="0,0,16,0" />
                                <ToggleSwitch Grid.Column="1" OnContent="" OffContent=""
                                    IsChecked="{Binding IsClipboardSyncEnabled}"
                                    RenderTransform="scale(1.25)" Margin="0,0,14,0"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Row="3" Text="{Binding ClipboardSyncStatus}"
                            Classes="accent" TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!-- File drop -->
                <Border Grid.Row="1" Classes="card">
                    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Classes="tile" Background="{DynamicResource IosOrangeBrush}">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                    Data="M12,16 V5 M7,10 L12,5 L17,10 M5,19 H19"
                                    Stroke="{DynamicResource IosAccentTextBrush}" StrokeThickness="2"
                                    StrokeLineCap="Round" StrokeJoin="Round"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="File drop" Classes="headline" />
                                <TextBlock Text="Send files in a moment." Classes="footnote" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Classes="well" ClipToBounds="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding FilePickerStatus}"
                                        Foreground="{DynamicResource IosLabelBrush}"
                                        FontSize="13" TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis" />
                                    <ItemsControl ItemsSource="{Binding SelectedFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                    Foreground="{DynamicResource IosLabel2Brush}"
                                                    FontSize="12.5"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="Choose files" Click="ChooseFiles_OnClick"
                                Classes="secondary" />
                            <Button Content="Send selected"
                                Command="{Binding SendSelectedFilesCommand}"
                                IsEnabled="{Binding CanSendFiles}" Classes="primary" />
                        </StackPanel>
                        <Grid Grid.Row="3">
                            <TextBlock Text="{Binding TransferStatus}" Classes="footnote"
                                TextWrapping="Wrap" MaxHeight="34"
                                TextTrimming="CharacterEllipsis" />
                            <Border IsVisible="{Binding HasIncomingTransferRequest}"
                                Background="{DynamicResource IosBlueTintBrush}"
                                CornerRadius="12" Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Incoming file · approve to receive"
                                            Foreground="{DynamicResource IosGreenTextBrush}"
                                            FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding IncomingTransferPrompt}"
                                            Foreground="{DynamicResource IosLabel2Brush}"
                                            FontSize="11.5" TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Spacing="6">
                                        <Button Content="Accept"
                                            Command="{Binding AcceptIncomingTransferCommand}"
                                            Classes="primary" Padding="14,4" MinHeight="30" />
                                        <Button Content="Decline"
                                            Command="{Binding RejectIncomingTransferCommand}"
                                            Classes="secondary" Padding="14,4" MinHeight="30" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Footer ===== -->
        <StackPanel Grid.Row="2" Margin="24,0,24,12" Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="Prototype notice: UniClip has not received an independent security review."
                Foreground="{DynamicResource IosWifiDisconnectedBrush}" FontSize="11.5"
                FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
            <HyperlinkButton Classes="security-link"
                Content="Read Security and privacy before using it with sensitive data"
                NavigateUri="https://github.com/Gowsi-kan/UniClip#security-and-privacy"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
