<Window
    x:Class="UniClip.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:UniClip.Views"
    xmlns:vm="using:UniClip.ViewModels"
    Title="UniClip"
    Width="1160"
    Height="760"
    MinWidth="1000"
    MinHeight="700"
    d:DesignHeight="760"
    d:DesignWidth="1160"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">
    <Grid x:Name="RootLayout" RowDefinitions="0,*">
        <Border
            x:Name="TitleBar"
            Grid.Row="0"
            chrome:WindowDecorationProperties.ElementRole="TitleBar"
            Background="#222328">
            <Grid ColumnDefinitions="138,*,138">
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#E8E8EC"
                    Text="UniClip" />
                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                        Classes="window-caption-button minimize"
                        Click="MinimizeWindow_OnClick">
                        <Border Width="10" Height="1" Background="#E8E8EC" />
                    </Button>
                    <Button
                        x:Name="MaximizeButton"
                        chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                        Classes="window-caption-button maximize"
                        Click="ToggleWindowState_OnClick">
                        <Grid Width="16" Height="16">
                            <Border
                                x:Name="MaximizeGlyph"
                                Width="10"
                                Height="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#E8E8EC"
                                BorderThickness="1" />
                            <Grid x:Name="RestoreGlyph" IsVisible="False">
                                <Border
                                    Width="9"
                                    Height="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    BorderBrush="#E8E8EC"
                                    BorderThickness="1" />
                                <Border
                                    Width="9"
                                    Height="9"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="#222328"
                                    BorderBrush="#E8E8EC"
                                    BorderThickness="1" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button
                        chrome:WindowDecorationProperties.ElementRole="CloseButton"
                        Classes="window-caption-button close"
                        Click="CloseWindow_OnClick">
                        <Border
                            Width="16"
                            Height="16"
                            Background="#168BFF"
                            CornerRadius="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="White"
                                TextAlignment="Center"
                                Text="×" />
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <views:MainView Grid.Row="1" />
        <Grid x:Name="ResizeHandles" IsVisible="False">
            <Border
                Height="5"
                VerticalAlignment="Top"
                chrome:WindowDecorationProperties.ElementRole="ResizeN"
                Background="Transparent" />
            <Border
                Height="5"
                VerticalAlignment="Bottom"
                chrome:WindowDecorationProperties.ElementRole="ResizeS"
                Background="Transparent" />
            <Border
                Width="5"
                HorizontalAlignment="Left"
                chrome:WindowDecorationProperties.ElementRole="ResizeW"
                Background="Transparent" />
            <Border
                Width="5"
                HorizontalAlignment="Right"
                chrome:WindowDecorationProperties.ElementRole="ResizeE"
                Background="Transparent" />
            <Border
                Width="8"
                Height="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                chrome:WindowDecorationProperties.ElementRole="ResizeNW"
                Background="Transparent" />
            <Border
                Width="8"
                Height="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                chrome:WindowDecorationProperties.ElementRole="ResizeNE"
                Background="Transparent" />
            <Border
                Width="8"
                Height="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                chrome:WindowDecorationProperties.ElementRole="ResizeSW"
                Background="Transparent" />
            <Border
                Width="8"
                Height="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                chrome:WindowDecorationProperties.ElementRole="ResizeSE"
                Background="Transparent" />
        </Grid>
    </Grid>
</Window>