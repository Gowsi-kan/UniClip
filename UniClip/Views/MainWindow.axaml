<Window
    x:Class="UniClip.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:UniClip.Views"
    xmlns:vm="using:UniClip.ViewModels"
    Title="UniClip"
    Width="1120"
    Height="760"
    MinWidth="900"
    MinHeight="660"
    d:DesignHeight="760"
    d:DesignWidth="1160"
    Icon="/Assets/UniClipIcon.ico"
    mc:Ignorable="d">
    <Grid x:Name="RootLayout" RowDefinitions="0,*">
        <Border
            x:Name="TitleBar"
            Grid.Row="0"
            chrome:WindowDecorationProperties.ElementRole="TitleBar"
            Background="{DynamicResource IosBgBrush}">
            <Grid ColumnDefinitions="138,*,138">
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource IosLabelBrush}"
                    Text="UniClip" />
                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                        Classes="window-caption-button minimize"
                        Click="MinimizeWindow_OnClick">
                        <Border
                            Width="10"
                            Height="1.5"
                            Margin="0,7,0,0"
                            Background="{DynamicResource IosLabel2Brush}"
                            CornerRadius="1" />
                    </Button>
                    <Button
                        x:Name="MaximizeButton"
                        chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                        Classes="window-caption-button maximize"
                        Click="ToggleWindowState_OnClick">
                        <Grid Width="14" Height="14">
                            <Border
                                x:Name="MaximizeGlyph"
                                Width="10"
                                Height="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="{DynamicResource IosLabel2Brush}"
                                BorderThickness="1.5"
                                CornerRadius="2.5" />
                            <Grid x:Name="RestoreGlyph" IsVisible="False">
                                <Border
                                    Width="9"
                                    Height="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    BorderBrush="{DynamicResource IosLabel2Brush}"
                                    BorderThickness="1.5"
                                    CornerRadius="2" />
                                <Border
                                    Width="9"
                                    Height="9"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource IosBgBrush}"
                                    BorderBrush="{DynamicResource IosLabel2Brush}"
                                    BorderThickness="1.5"
                                    CornerRadius="2" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button
                        chrome:WindowDecorationProperties.ElementRole="CloseButton"
                        Classes="window-caption-button close"
                        Click="CloseWindow_OnClick">
                        <Path
                            Width="9"
                            Height="9"
                            Data="M0,0 L9,9 M9,0 L0,9"
                            Stroke="{DynamicResource IosLabel2Brush}"
                            StrokeLineCap="Round"
                            StrokeThickness="1.7" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <views:MainView Grid.Row="1" />

        <Grid x:Name="ResizeHandles" IsVisible="False">
            <Border
                Height="5"
                VerticalAlignment="Top"
                chrome:WindowDecorationProperties.ElementRole="ResizeN"
                Background="Transparent" />
            <Border
                Height="5"
                VerticalAlignment="Bottom"
                chrome:WindowDecorationProperties.ElementRole="ResizeS"
                Background="Transparent" />
            <Border
                Width="5"
                HorizontalAlignment="Left"
                chrome:WindowDecorationProperties.ElementRole="ResizeW"
                Background="Transparent" />
            <Border
                Width="5"
                HorizontalAlignment="Right"
                chrome:WindowDecorationProperties.ElementRole="ResizeE"
                Background="Transparent" />
            <Border
                Width="8"
                Height="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                chrome:WindowDecorationProperties.ElementRole="ResizeNW"
                Background="Transparent" />
            <Border
                Width="8"
                Height="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                chrome:WindowDecorationProperties.ElementRole="ResizeNE"
                Background="Transparent" />
            <Border
                Width="8"
                Height="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                chrome:WindowDecorationProperties.ElementRole="ResizeSW"
                Background="Transparent" />
            <Border
                Width="8"
                Height="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                chrome:WindowDecorationProperties.ElementRole="ResizeSE"
                Background="Transparent" />
        </Grid>
    </Grid>
</Window>
