<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UniClip"
             x:Class="UniClip.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="Background" Value="#202A23" />
            <Setter Property="Foreground" Value="#E7EDE5" />
            <Setter Property="BorderBrush" Value="#354136" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#2B382D" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#354536" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#B8F36B" />
            <Setter Property="Foreground" Value="#18210F" />
            <Setter Property="BorderBrush" Value="#B8F36B" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#C9FA88" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#202A23" />
            <Setter Property="Foreground" Value="#D6DFD3" />
        </Style>
        <Style Selector="Button.window-caption-button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8E8EC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.window-caption-button:pointerover">
            <Setter Property="Background" Value="#3A3B40" />
        </Style>
        <Style Selector="Button.window-caption-button:pressed">
            <Setter Property="Background" Value="#48494F" />
        </Style>
        <Style Selector="Button.window-caption-button.close:pointerover">
            <Setter Property="Background" Value="#C42B1C" />
        </Style>
        <Style Selector="Button.window-caption-button.close:pressed">
            <Setter Property="Background" Value="#A82418" />
        </Style>
    </Application.Styles>
</Application>