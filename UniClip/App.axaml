<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UniClip"
             x:Class="UniClip.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="Background" Value="#202A23" />
            <Setter Property="Foreground" Value="#E7EDE5" />
            <Setter Property="BorderBrush" Value="#354136" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#2B382D" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#354536" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#B8F36B" />
            <Setter Property="Foreground" Value="#18210F" />
            <Setter Property="BorderBrush" Value="#B8F36B" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#C9FA88" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#202A23" />
            <Setter Property="Foreground" Value="#D6DFD3" />
        </Style>
    </Application.Styles>
</Application>